{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mdl-youtube-token",
  "main": "src/index.ts",
  "account_id": "7bc5bf0e3b7386107e27d74c22b449c0",
  "compatibility_date": "2026-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "placement": { "mode": "smart" },
  "observability": { "enabled": true },
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "TOKEN_RATE_LIMITER",
        "class_name": "TokenRateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["TokenRateLimiter"]
    }
  ],
  "kv_namespaces": [
    {
      "id": "2812a928915d4f53af499f6dfd16e0a3",
      "preview_id": "728257d93d3d4f46865a7e4d5ff0a237",
      "binding": "PO_TOKEN_KV",
    }
  ]
}
